# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-4-hydrogen"
GEMINI_CALL_TIMEOUT_MS=25000

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional API Key for protected REST endpoints (X-API-Key header).
# Leave empty in local development to allow open local access, or set a strong secret in production.
VERISTEM_API_KEY=

# Cryptographically random session signing secret (>= 32 bytes / 64 hex chars recommended)
SESSION_SECRET=your_secure_session_secret_here

# Database URL for Python backend (SQLite default, PostgreSQL supported via SQLAlchemy)
DATABASE_URL="sqlite+aiosqlite:///./veristem_data.db"
LANGGRAPH_CHECKPOINT_DB="./veristem_checkpoints.db"

# Workflow & Sandbox Configuration
MAX_CORRECTION_ATTEMPTS=3
SANDBOX_TIMEOUT_SECONDS=10
SANDBOX_MEMORY_MB=256
RATE_LIMIT_REQUESTS_PER_MINUTE=60
LOG_LEVEL="INFO"
OTEL_SERVICE_NAME="veristem-api"
DISABLE_HMR=false
